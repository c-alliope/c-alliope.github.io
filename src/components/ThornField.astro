---
---
// ThornField with Unreal bloom — blood glows, bone pops, sun burns.

<canvas id="thornfield" class="fixed inset-0 -z-0 h-full w-full opacity-90" aria-hidden="true"></canvas>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
  import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';

  const canvas = document.getElementById('thornfield') as HTMLCanvasElement | null;
  if (canvas) {
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x060607, 0.055);
    const camera = new THREE.PerspectiveCamera(60, innerWidth / innerHeight, 0.1, 100);
    camera.position.set(0, 0.6, 9);

    const COUNT = Math.floor(4200 * 1);
    const pos = new Float32Array(COUNT * 3);
    const col = new Float32Array(COUNT * 3);
    const seed = new Float32Array(COUNT);
    const blood = new THREE.Color('#c8102e');
    const deep = new THREE.Color('#5c0716');
    const bone = new THREE.Color('#e8e0d0');

    for (let i = 0; i < COUNT; i++) {
      const r = 3 + Math.random() * 14;
      const th = Math.random() * Math.PI * 2;
      const y = (Math.random() - 0.5) * 14;
      pos[i * 3] = Math.cos(th) * r;
      pos[i * 3 + 1] = y;
      pos[i * 3 + 2] = Math.sin(th) * r - 4;
      const c = Math.random();
      const cc = c < 0.72 ? blood.clone().lerp(deep, Math.random()) : c < 0.9 ? deep : bone;
      col[i * 3] = cc.r; col[i * 3 + 1] = cc.g; col[i * 3 + 2] = cc.b;
      seed[i] = Math.random() * 100;
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
    const mat = new THREE.PointsMaterial({
      size: 0.055, vertexColors: true, transparent: true, opacity: 0.85,
      sizeAttenuation: true, depthWrite: false, blending: THREE.AdditiveBlending,
    });
    const points = new THREE.Points(geo, mat);
    scene.add(points);

    // red sun disc
    const sunGeo = new THREE.CircleGeometry(2.1, 64);
    const sunMat = new THREE.MeshBasicMaterial({ color: 0xc8102e, transparent: true, opacity: 0.85, fog: false });
    const sun = new THREE.Mesh(sunGeo, sunMat);
    sun.position.set(3.4, 1.6, -9);
    scene.add(sun);
    const sunHalo = new THREE.Mesh(
      new THREE.RingGeometry(2.2, 2.35, 64),
      new THREE.MeshBasicMaterial({ color: 0xe8e0d0, transparent: true, opacity: 0.28, side: THREE.DoubleSide, fog: false })
    );
    sunHalo.position.copy(sun.position);
    scene.add(sunHalo);

    // thorn lines — sparse connective strokes
    const lineGeo = new THREE.BufferGeometry();
    const LP = 260;
    const lp = new Float32Array(LP * 6);
    for (let i = 0; i < LP; i++) {
      const a = (Math.random() - 0.5) * 16;
      const b = (Math.random() - 0.5) * 10;
      const c = -2 - Math.random() * 10;
      lp[i * 6] = a; lp[i * 6 + 1] = b; lp[i * 6 + 2] = c;
      lp[i * 6 + 3] = a + (Math.random() - 0.5) * 3;
      lp[i * 6 + 4] = b + (Math.random() - 0.5) * 3;
      lp[i * 6 + 5] = c + (Math.random() - 0.5) * 2;
    }
    lineGeo.setAttribute('position', new THREE.BufferAttribute(lp, 3));
    const lines = new THREE.LineSegments(lineGeo, new THREE.LineBasicMaterial({ color: 0x8a8a93, transparent: true, opacity: 0.16 }));
    scene.add(lines);

    let mx = 0, my = 0, warp = 0;
    addEventListener('mousemove', (e) => {
      mx = (e.clientX / innerWidth - 0.5) * 2;
      my = (e.clientY / innerHeight - 0.5) * 2;
    });
    (window as any).__warpBoost = () => { warp = Math.min(warp + 3.2, 5); };

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const bloom = new UnrealBloomPass(
      new THREE.Vector2(innerWidth, innerHeight),
      0.85, // strength — blood glow without nuking text
      0.65, // radius
      0.12  // threshold — only bright reds/bone bloom
    );
    composer.addPass(bloom);
    composer.addPass(new OutputPass());

    function resize() {
      renderer.setSize(innerWidth, innerHeight, false);
      composer.setSize(innerWidth, innerHeight);
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
    }
    resize();
    addEventListener('resize', resize);

    const clock = new THREE.Clock();
    let raf = 0;
    // pause when tab hidden / reduced motion
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function tick() {
      raf = requestAnimationFrame(tick);
      if (document.hidden) return;
      const t = clock.getElapsedTime();
      warp = Math.max(0, warp - 0.02);
      const p = geo.attributes.position as THREE.BufferAttribute;
      const arr = p.array as Float32Array;
      const swirl = 0.12 + warp * 0.55;
      for (let i = 0; i < COUNT; i += 2) {
        const s = seed[i];
        arr[i * 3] += Math.sin(t * 0.6 + s) * 0.0035 * (1 + warp);
        arr[i * 3 + 1] += Math.cos(t * 0.4 + s * 1.7) * 0.004 * (1 + warp * 0.7);
        // slow orbit around center
        const x = arr[i * 3], z = arr[i * 3 + 2];
        const ang = swirl * 0.002;
        arr[i * 3] = x * Math.cos(ang) - z * Math.sin(ang);
        arr[i * 3 + 2] = x * Math.sin(ang) + z * Math.cos(ang);
      }
      p.needsUpdate = true;
      points.rotation.y = mx * 0.22 + t * 0.02;
      points.rotation.x = my * 0.12;
      lines.rotation.y = mx * 0.1 + t * 0.008;
      sun.position.x = 3.4 + mx * 0.6;
      sun.position.y = 1.6 - my * 0.5;
      const pulse = 1 + Math.sin(t * 1.4) * 0.03 + warp * 0.06;
      sun.scale.setScalar(pulse);
      camera.position.z = 9 - warp * 1.4;
      // bloom intensity breathes + spikes on warp (portal click)
      bloom.strength = 0.85 + Math.sin(t * 1.4) * 0.1 + warp * 0.25;
      composer.render();
    }
    if (!reduced) tick();
    else composer.render();
  }
</script>
