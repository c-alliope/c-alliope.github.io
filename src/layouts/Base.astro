---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'cal.dev', description = 'portfolio — resume, works, log. black / blood / bone.' } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="grain">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#060607" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pirata+One&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-void text-bone antialiased">
    <div class="cursor-dot no-print hidden md:block" id="cdot" style="opacity:0" aria-hidden="true"></div>
    <div class="cursor-ring no-print hidden md:block" id="cring" style="opacity:0" aria-hidden="true"></div>
    <button id="sound-toggle" aria-pressed="false" class="hud-label no-print fixed bottom-4 right-4 z-[60] border border-bone/25 bg-void/80 px-3 py-2 backdrop-blur-md hover:border-blood hover:text-blood transition-colors">sound — off</button>

    <!-- HUD top bar -->
    <header class="no-print fixed top-0 left-0 right-0 z-50 border-b border-bone/10 bg-void/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-2.5 md:px-8">
        <a href="/" data-absorb class="hud-label hover:text-blood transition-colors">
          <span class="text-blood">●</span>&nbsp; cal.dev
        </a>
        <nav class="flex items-center gap-4 md:gap-8">
          <a href="/resume" data-absorb class={`hud-label hover:text-bone transition-colors ${path.startsWith('/resume') ? 'text-bone' : ''}`}>resume</a>
          <a href="/projects" data-absorb class={`hud-label hover:text-bone transition-colors ${path.startsWith('/projects') ? 'text-bone' : ''}`}>works</a>
          <a href="/log" data-absorb class={`hud-label hover:text-bone transition-colors ${path.startsWith('/log') ? 'text-bone' : ''}`}>log</a>
        </nav>
      </div>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="no-print relative z-10 border-t border-bone/10 mt-24">
      <div class="mx-auto max-w-5xl px-4 md:px-8 py-10 flex flex-col md:flex-row justify-between gap-6">
        <div>
          <p class="display-black text-3xl">cal</p>
          <p class="hud-label mt-2">black / blood / bone — v1.0</p>
        </div>
        <div class="flex gap-6 items-end">
          <a href="https://github.com/c-alliope" class="hud-label hover:text-blood" target="_blank" rel="noreferrer">github ↗</a>
          <a href="/log" data-absorb class="hud-label hover:text-blood">log</a>
          <a href="/resume" data-absorb class="hud-label hover:text-blood">resume</a>
        </div>
      </div>
      <div class="rule"></div>
      <p class="text-center hud-label py-4 opacity-60">© 2026 cal / calliope — built with astro + three.js, hosted on github pages</p>
    </footer>

    <script>
      import { navigate } from 'astro:transitions/client';
      // consume transition: the new page masks in from the click point and eats the old one.
      // Singleton: SPA swaps re-run this script, but window persists — register exactly once
      // or handlers stack and every click fires N navigations.
      if (!(window as any).__absorbInit) {
        (window as any).__absorbInit = true;
        // capture + stopPropagation keeps the router out — exactly one history entry.
        document.addEventListener('click', (e) => {
          const t = (e.target as HTMLElement).closest('a[data-absorb]') as HTMLAnchorElement | null;
          if (!t) return;
          const href = t.getAttribute('href');
          if (!href || href.startsWith('http') || href.startsWith('#') || e.metaKey || e.ctrlKey || e.button === 2) return;
          e.preventDefault();
          e.stopPropagation();
          const r = document.documentElement;
          r.style.setProperty('--ax', e.clientX + 'px');
          r.style.setProperty('--ay', e.clientY + 'px');
          // boost thornfield warp if present
          (window as any).__warpBoost?.();
          navigate(href);
        }, true);

        // back/forward restores can freeze mid-transition state — make sure no mask sticks.
        addEventListener('pageshow', () => {
          document.documentElement.style.removeProperty('--ax');
          document.documentElement.style.removeProperty('--ay');
        });
      }

      // custom cursor — singleton. SPA swaps replace #cdot/#cring, so elements are
      // looked up every frame; one loop + one listener survive all navigations.
      if (!(window as any).__cursorInit) {
        (window as any).__cursorInit = true;
        let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
        let seen = false, gen = 0;
        const fine = () => matchMedia('(pointer:fine)').matches;
        document.addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY; seen = true;
        });
        document.addEventListener('mouseleave', () => { seen = false; });
        function kickCursor() {
          gen++;
          const g = gen;
          requestAnimationFrame(function loop() {
            if (g !== gen) return; // superseded (e.g. bfcache restore re-kick)
            const dot = document.getElementById('cdot');
            const ring = document.getElementById('cring');
            const show = seen && fine() && !!dot && !!ring;
            if (dot) {
              dot.style.opacity = show ? '' : '0';
              if (show) { dot.style.left = mx + 'px'; dot.style.top = my + 'px'; }
            }
            if (ring) {
              ring.style.opacity = show ? '' : '0';
              if (show) {
                rx += (mx - rx) * 0.16; ry += (my - ry) * 0.16;
                ring.style.left = rx + 'px'; ring.style.top = ry + 'px';
              }
            }
            requestAnimationFrame(loop);
          });
        }
        kickCursor();
        addEventListener('pageshow', kickCursor);
        document.addEventListener('astro:page-load', kickCursor);
      }

      // headline scramble on load
      const chars = '█▓▒░<>/\\|+×#CALIOPE01';
      document.querySelectorAll('.scramble').forEach((el) => {
        const orig = el.textContent || '';
        let frame = 0;
        const total = 28;
        const timer = setInterval(() => {
          frame++;
          const p = frame / total;
          const reveal = Math.floor(orig.length * p);
          let out = orig.slice(0, reveal);
          for (let i = reveal; i < orig.length; i++) {
            out += orig[i] === ' ' ? ' ' : chars[Math.floor(Math.random() * chars.length)];
          }
          el.textContent = out;
          if (frame >= total) { el.textContent = orig; clearInterval(timer); }
        }, 30);
      });
    </script>

    <script>
      // generative dark ambient: detuned low drone + slow heartbeat drums.
      // default off (autoplay is blocked + surprise sound is rude); toggle persists.
      // Singleton + delegated clicks: SPA swaps replace the button, so the handler
      // lives on document and the engine outlives navigations (music never restarts).
      if (!(window as any).__soundInit) {
        (window as any).__soundInit = true;
        const SKEY = 'cal-sound';
        let actx = null, master = null, beatTimer = null, extraTO = null;
        let sounding = false;

        function buildEngine() {
          actx = new (window.AudioContext || (window as any).webkitAudioContext)();
          master = actx.createGain();
          master.gain.value = 0;
          master.connect(actx.destination);

          // drone bed
          const lp = actx.createBiquadFilter();
          lp.type = 'lowpass'; lp.frequency.value = 200; lp.Q.value = 0.8;
          lp.connect(master);
          const lfo = actx.createOscillator(); lfo.frequency.value = 0.07;
          const lfoAmt = actx.createGain(); lfoAmt.gain.value = 60;
          lfo.connect(lfoAmt); lfoAmt.connect(lp.frequency); lfo.start();
          [[55, 'sine', 0.05], [55.7, 'sine', 0.05], [110.3, 'triangle', 0.018]].forEach(([f, ty, g]) => {
            const o = actx.createOscillator() as OscillatorNode;
            o.type = ty as OscillatorType; o.frequency.value = f as number;
            const og = actx.createGain(); og.gain.value = g as number;
            o.connect(og); og.connect(lp); o.start();
          });

          // faint noise wash
          const len = actx.sampleRate * 2;
          const buf = actx.createBuffer(1, len, actx.sampleRate);
          const d = buf.getChannelData(0);
          for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
          const wash = actx.createBufferSource(); wash.buffer = buf; wash.loop = true;
          const wf = actx.createBiquadFilter(); wf.type = 'lowpass'; wf.frequency.value = 240;
          const wg = actx.createGain(); wg.gain.value = 0.014;
          wash.connect(wf); wf.connect(wg); wg.connect(master); wash.start();
        }

        function thump() {
          if (!actx || !master) return;
          const t = actx.currentTime;
          const o = actx.createOscillator(); o.type = 'sine';
          o.frequency.setValueAtTime(62, t);
          o.frequency.exponentialRampToValueAtTime(36, t + 0.28);
          const g = actx.createGain();
          g.gain.setValueAtTime(0.5, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.42);
          o.connect(g); g.connect(master);
          o.start(t); o.stop(t + 0.5);
        }

        function startSound() {
          if (!actx) buildEngine();
          actx!.resume();
          master!.gain.setTargetAtTime(0.14, actx!.currentTime, 1.2);
          if (beatTimer) clearInterval(beatTimer);
          let n = 0;
          thump();
          beatTimer = window.setInterval(() => {
            thump();
            n++;
            if (n % 4 === 3) extraTO = window.setTimeout(thump, 290); // heartbeat double-hit
          }, 1150);
          sounding = true;
        }

        function stopSound() {
          if (actx && master) master.gain.setTargetAtTime(0, actx.currentTime, 0.25);
          if (beatTimer) { clearInterval(beatTimer); beatTimer = null; }
          if (extraTO) { clearTimeout(extraTO); extraTO = null; }
          sounding = false;
        }

        function paintBtn() {
          const b = document.getElementById('sound-toggle');
          if (!b) return;
          b.textContent = sounding ? 'sound — on' : 'sound — off';
          b.setAttribute('aria-pressed', String(sounding));
        }

        document.addEventListener('click', (e) => {
          if (!(e.target as HTMLElement).closest('#sound-toggle')) return;
          if (sounding) { stopSound(); try { localStorage.setItem(SKEY, 'off'); } catch {} }
          else { startSound(); try { localStorage.setItem(SKEY, 'on'); } catch {} }
          paintBtn();
        });

        document.addEventListener('astro:page-load', paintBtn);

        // full page loads kill audio; if they left it on, resume on first gesture
        try {
          if (localStorage.getItem(SKEY) === 'on') {
            sounding = true; paintBtn();
            const arm = () => { if (sounding && !actx) startSound(); };
            addEventListener('pointerdown', arm, { once: true });
            addEventListener('keydown', arm, { once: true });
          }
        } catch {}
      }
    </script>
  </body>
</html>
