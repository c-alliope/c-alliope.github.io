---
import Base from '../layouts/Base.astro';
---

<Base title="cal.dev — library">
  <section class="mx-auto max-w-5xl px-4 md:px-8 pt-28 pb-16">
    <p class="hud-label">04 / library — calliope red</p>
    <div class="relative mt-2">
      <div class="absolute left-[8%] top-1/2 h-[65%] w-[55%] -translate-y-1/2 rounded-full bg-blood/25 blur-[80px]" aria-hidden="true"></div>
      <h1 class="relative font-grot font-bold lowercase leading-none tracking-tight text-bone text-[18vw] md:text-[7rem]" style="text-shadow: 0 2px 18px rgba(0,0,0,0.75), 0 0 44px rgba(200,16,46,0.35);">library<span class="text-blood">.</span></h1>
    </div>
    <p class="max-w-lg text-sm text-bone/70 mt-4">
      The living UI kit behind cal.dev — every primitive below is production code from this page.
      Tokens: void <code class="text-blood">#060607</code> · blood <code class="text-blood">#c8102e</code> · bone <code class="text-blood">#e8e0d0</code>.
    </p>

    <!-- BUTTONS -->
    <h2 class="hud-label text-blood mt-16">buttons</h2>
    <div class="mt-4 border-t border-l border-bone/15 grid grid-cols-1 md:grid-cols-2">
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">solid — primary action</p>
        <button class="bg-blood px-6 py-3 text-sm font-bold tracking-wide text-white rounded-[2px] hover:bg-[#a50d27] active:translate-y-px transition">enter works</button>
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">outline — secondary</p>
        <button class="border border-bone/25 px-6 py-3 text-sm font-bold tracking-wide text-bone rounded-[2px] hover:border-blood hover:text-blood active:translate-y-px transition">read log</button>
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">ghost — quiet</p>
        <button class="px-4 py-2 text-sm font-bold text-bone/70 rounded-[2px] hover:text-bone hover:bg-smoke active:translate-y-px transition">dismiss</button>
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">mono — hud action</p>
        <button class="hud-label border border-blood/60 px-4 py-2 text-blood hover:bg-blood hover:text-white active:translate-y-px transition">↓ print / pdf</button>
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">sizes — sm / md / lg</p>
        <div class="flex flex-wrap items-center gap-3">
          <button class="bg-blood px-3 py-1.5 text-xs font-bold text-white rounded-[2px] hover:bg-[#a50d27] transition">small</button>
          <button class="bg-blood px-6 py-3 text-sm font-bold text-white rounded-[2px] hover:bg-[#a50d27] transition">medium</button>
          <button class="bg-blood px-8 py-4 text-base font-bold text-white rounded-[2px] hover:bg-[#a50d27] transition">large</button>
        </div>
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">disabled</p>
        <button disabled class="bg-smoke px-6 py-3 text-sm font-bold text-bone/40 rounded-[2px] cursor-not-allowed">blocked</button>
      </div>
    </div>

    <!-- INPUTS -->
    <h2 class="hud-label text-blood mt-16">inputs</h2>
    <div class="mt-4 border-t border-l border-bone/15 grid grid-cols-1 md:grid-cols-2">
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">text — focus goes blood</p>
        <label class="hud-label block mb-2" for="lib-name">callsign</label>
        <input id="lib-name" type="text" placeholder="cal" class="w-full bg-coal border border-bone/20 rounded-[2px] px-4 py-3 text-sm text-bone placeholder:text-bone/30 outline-none focus:border-blood transition-colors" />
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">area — log entry</p>
        <label class="hud-label block mb-2" for="lib-msg">message</label>
        <textarea id="lib-msg" rows="3" placeholder="write it down…" class="w-full bg-coal border border-bone/20 rounded-[2px] px-4 py-3 text-sm text-bone placeholder:text-bone/30 outline-none focus:border-blood transition-colors resize-y"></textarea>
      </div>
    </div>

    <!-- SELECTION -->
    <h2 class="hud-label text-blood mt-16">selection</h2>
    <div class="mt-4 border-t border-l border-bone/15 grid grid-cols-1 md:grid-cols-2">
      <div class="border-b border-r border-bone/15 p-6 space-y-4">
        <p class="hud-label">checks — square, never round</p>
        <label class="flex items-center gap-3 text-sm text-bone/80 cursor-pointer">
          <input type="checkbox" checked class="peer sr-only" />
          <span class="grid h-5 w-5 place-items-center border border-bone/30 rounded-[2px] text-transparent peer-checked:border-blood peer-checked:bg-blood peer-checked:text-white transition">✓</span>
          ship it
        </label>
        <label class="flex items-center gap-3 text-sm text-bone/80 cursor-pointer">
          <input type="checkbox" class="peer sr-only" />
          <span class="grid h-5 w-5 place-items-center border border-bone/30 rounded-[2px] text-transparent peer-checked:border-blood peer-checked:bg-blood peer-checked:text-white transition">✓</span>
          polish later
        </label>
      </div>
      <div class="border-b border-r border-bone/15 p-6">
        <p class="hud-label mb-4">toggle — try it</p>
        <label class="inline-flex cursor-pointer items-center gap-3">
          <input type="checkbox" id="lib-toggle" class="peer sr-only" checked />
          <span class="relative h-6 w-11 rounded-full bg-smoke border border-bone/20 transition peer-checked:bg-blood-deep peer-checked:border-blood after:absolute after:top-0.5 after:left-0.5 after:h-[18px] after:w-[18px] after:rounded-full after:bg-bone after:transition peer-checked:after:translate-x-5"></span>
          <span id="lib-toggle-label" class="text-sm text-bone/80">live</span>
        </label>
      </div>
    </div>

    <!-- CHIPS + STATUS -->
    <h2 class="hud-label text-blood mt-16">chips + status</h2>
    <div class="mt-4 border border-bone/15 p-6 flex flex-wrap items-center gap-2">
      <span class="hud-label border border-bone/20 bg-smoke px-3 py-1.5 rounded-[2px]">astro</span>
      <span class="hud-label border border-bone/20 px-3 py-1.5 rounded-[2px] !text-bone/60">draft</span>
      <span class="hud-label border border-blood/60 text-blood px-3 py-1.5 rounded-[2px]">● live</span>
      <span class="inline-flex items-center gap-2 text-sm text-bone/70"><span class="relative flex h-2 w-2"><span class="absolute h-full w-full animate-ping rounded-full bg-blood opacity-60"></span><span class="h-2 w-2 rounded-full bg-blood"></span></span>shipping</span>
    </div>

    <!-- FEEDBACK -->
    <h2 class="hud-label text-blood mt-16">feedback</h2>
    <div class="mt-4 space-y-3">
      <div class="border border-bone/15 border-l-2 border-l-blood bg-coal rounded-[2px] px-5 py-4">
        <p class="hud-label text-blood mb-1">notice</p>
        <p class="text-sm text-bone/75">3 slots open — placeholder cards until real work lands.</p>
      </div>
      <div class="border border-bone/15 bg-coal rounded-[2px] px-5 py-4">
        <p class="hud-label mb-3">progress — 2 / 3 slots claimed</p>
        <div class="h-2 w-full bg-smoke rounded-[2px] overflow-hidden">
          <div class="h-full w-2/3 bg-blood rounded-[2px]"></div>
        </div>
      </div>
    </div>

    <!-- SURFACE -->
    <h2 class="hud-label text-blood mt-16">surface — ridge mini</h2>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="ridge-card relative overflow-hidden rounded-[2px] border border-bone/20 min-h-[220px]">
        <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
          <defs>
            <linearGradient id="rg-lib" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#232329"/><stop offset="0.52" stop-color="#4d0e1a"/><stop offset="1" stop-color="#a50d27"/>
            </linearGradient>
            <filter id="rgf-lib" x="0%" y="0%" width="100%" height="100%">
              <feTurbulence type="fractalNoise" baseFrequency="0.01 0.12" numOctaves="4" seed="99" stitchTiles="stitch" result="n"/>
              <feColorMatrix in="n" type="saturate" values="0" result="g"/>
              <feComponentTransfer><feFuncR type="discrete" tableValues="0 0.3 0.55 0.8 1"/><feFuncG type="discrete" tableValues="0 0.3 0.55 0.8 1"/><feFuncB type="discrete" tableValues="0 0.3 0.55 0.8 1"/></feComponentTransfer>
            </filter>
          </defs>
          <rect width="400" height="260" fill="url(#rg-lib)"/>
          <rect width="400" height="260" filter="url(#rgf-lib)" opacity="0.5" style="mix-blend-mode:overlay"/>
        </svg>
        <div class="crt absolute inset-0"></div>
        <span class="absolute left-3 top-2.5 z-10 font-grot text-sm font-bold lowercase tracking-tight text-bone" style="text-shadow:0 1px 10px rgba(0,0,0,.85)">ridge</span>
      </div>
      <div class="border border-bone/15 bg-coal rounded-[2px] p-6">
        <p class="hud-label mb-4">dossier cell</p>
        <dl class="grid grid-cols-2 border-t border-l border-bone/15">
          <div class="border-b border-r border-bone/15 px-4 py-3"><dt class="hud-label">focus</dt><dd class="mt-1 text-sm text-bone">ui + code</dd></div>
          <div class="border-b border-r border-bone/15 px-4 py-3"><dt class="hud-label">status</dt><dd class="mt-1 text-sm text-blood">live</dd></div>
        </dl>
        <a href="/projects" data-absorb class="hud-label mt-5 inline-block text-bone underline decoration-blood underline-offset-4 hover:text-blood transition-colors">back to works →</a>
      </div>
    </div>

    <div class="rule my-12"></div>
    <p class="hud-label opacity-60">calliope red library v1 — spec lives in ~/projects/cal-dev-specs.md</p>
  </section>

  <script>
    const t = document.getElementById('lib-toggle') as HTMLInputElement | null;
    const l = document.getElementById('lib-toggle-label');
    t?.addEventListener('change', () => { if (l) l.textContent = t.checked ? 'live' : 'held'; });
  </script>
</Base>
