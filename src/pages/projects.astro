---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';

// gradient intensity per tone — all dark so bone text always reads
const stops: Record<string, [string, string, string]> = {
  red: ['#4d0e1a', '#7a0f20', '#c8102e'],
  bone: ['#2b2b31', '#4a2530', '#8a2432'],
  black: ['#1c1c22', '#2a0d13', '#4d0e1a'],
};
---

<Base title="calliope.red — works">
  <section class="mx-auto max-w-7xl px-4 md:px-8 pt-28 pb-10">
    <p class="hud-label">02 / works — poster gallery</p>
    <div class="relative mt-2">
      <div class="absolute left-[8%] top-1/2 h-[65%] w-[55%] -translate-y-1/2 rounded-full bg-blood/25 blur-[80px]" aria-hidden="true"></div>
      <h1 class="relative font-grot font-bold lowercase leading-none tracking-tight text-bone text-[18vw] md:text-[9rem]" style="text-shadow: 0 2px 18px rgba(0,0,0,0.75), 0 0 44px rgba(200,16,46,0.35);">works<span class="text-blood">.</span></h1>
    </div>
    <p class="max-w-lg text-sm text-bone/70 mt-4">
      Placeholder gallery — <span class="text-bone">not seeded</span> with your old repos per your call.
      Add real pieces in <code class="text-blood">src/data/projects.json</code>. Each entry becomes a poster card. Delete the DRAFTs when ready.
    </p>
    <div class="rule my-8"></div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((p, i) => {
        const s = stops[p.tone] ?? stops.black;
        return (
          <article class="ridge-card group relative overflow-hidden rounded-[2px] border border-bone/20 hover:border-blood transition-colors">
            <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
              <defs>
                <linearGradient id={`rg-w${i}`} x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color={s[0]} /><stop offset="0.52" stop-color={s[1]} /><stop offset="1" stop-color={s[2]} />
                </linearGradient>
                <radialGradient id={`rgv-w${i}`} cx="0.5" cy="0.42" r="0.75">
                  <stop offset="0.55" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity="0.55" />
                </radialGradient>
                <filter id={`rgf-w${i}`} x="0%" y="0%" width="100%" height="100%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.008 0.11" numOctaves="4" seed={10 + i * 17} stitchTiles="stitch" result="n" />
                  <feColorMatrix in="n" type="saturate" values="0" result="g" />
                  <feComponentTransfer result="b">
                    <feFuncR type="discrete" tableValues="0 0.3 0.55 0.8 1" /><feFuncG type="discrete" tableValues="0 0.3 0.55 0.8 1" /><feFuncB type="discrete" tableValues="0 0.3 0.55 0.8 1" />
                  </feComponentTransfer>
                </filter>
                <filter id={`rgl-w${i}`} x="0%" y="0%" width="100%" height="100%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.006 0.045" numOctaves="3" seed={50 + i * 13} stitchTiles="stitch" result="n" />
                  <feColorMatrix in="n" type="saturate" values="0" result="g" />
                  <feComponentTransfer>
                    <feFuncR type="discrete" tableValues="0 0 1 1" /><feFuncG type="discrete" tableValues="0 0 1 1" /><feFuncB type="discrete" tableValues="0 0 1 1" />
                  </feComponentTransfer>
                </filter>
              </defs>
              <rect width="400" height="500" fill={`url(#rg-w${i})`} />
              <rect width="400" height="500" filter={`url(#rgf-w${i})`} opacity="0.5" style="mix-blend-mode:overlay" />
              <rect width="400" height="500" filter={`url(#rgl-w${i})`} opacity="0.4" style="mix-blend-mode:soft-light" />
              <rect width="400" height="500" fill={`url(#rgv-w${i})`} />
            </svg>
            <div class="crt absolute inset-0"></div>
            <div class="relative z-10 p-6 min-h-[340px] flex flex-col justify-between">
              <div class="flex justify-between">
                <span class="hud-label !text-bone/60">{p.tag} — {p.year}</span>
                <span class="hud-label !text-blood">0{i + 1}</span>
              </div>
              <div>
                <h2 class="font-grot font-bold text-3xl leading-none tracking-tight lowercase text-bone" style="text-shadow:0 1px 12px rgba(0,0,0,.8)">{p.title}</h2>
                <p class="text-sm mt-3 leading-relaxed text-bone/70">{p.blurb}</p>
                <div class="flex flex-wrap gap-2 mt-4">
                  {p.stack.map((st) => (
                    <span class="hud-label !text-bone/60 border border-bone/25 px-2 py-1">{st}</span>
                  ))}
                </div>
              </div>
              <a href={p.link} class="hud-label mt-6 inline-block text-bone underline decoration-blood underline-offset-4 hover:text-blood transition-colors">open →</a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-10 border border-dashed border-blood/50 p-5">
      <p class="hud-label text-blood">how to add work</p>
      <pre class="mt-3 text-xs leading-relaxed text-bone/70 overflow-x-auto">{`// src/data/projects.json
{
  "slug": "my-piece",
  "title": "my piece",
  "tag": "SITE",
  "year": "2026",
  "blurb": "one-two lines, poster voice.",
  "stack": ["astro", "three.js"],
  "link": "https://…",
  "tone": "red" // red | bone | black — gradient intensity
}`}</pre>
    </div>
  </section>
</Base>

<style>
  .ridge-card {
    box-shadow: 0 0 60px -20px rgba(200, 16, 46, 0.45), 0 24px 50px -30px rgba(0, 0, 0, 0.9);
  }
</style>
