---
import Base from '../layouts/Base.astro';
---

<Base title="cal.dev — reclaim">
  <section class="mx-auto max-w-5xl px-4 md:px-8 pt-28 pb-16">
    <p class="hud-label">05 / app — procedural brutalism</p>
    <div class="relative mt-2">
      <div class="absolute left-[8%] top-1/2 h-[65%] w-[55%] -translate-y-1/2 rounded-full bg-blood/25 blur-[80px]" aria-hidden="true"></div>
      <h1 class="relative font-grot font-bold lowercase leading-none tracking-tight text-bone text-[18vw] md:text-[7rem]" style="text-shadow: 0 2px 18px rgba(0,0,0,0.75), 0 0 44px rgba(200,16,46,0.35);">reclaim<span class="text-blood">.</span></h1>
    </div>
    <p class="max-w-lg text-sm text-bone/70 mt-4">
      stamp concrete blocks, the district overgrows around them. every seed grows the same city twice — share it.
    </p>

    <!-- canvas -->
    <div class="mt-8 border border-bone/20 rounded-[2px] overflow-hidden bg-black" style="box-shadow: 0 0 70px -18px rgba(200,16,46,0.5);">
      <canvas id="reclaim-view" width="320" height="176" class="block h-auto w-full" style="image-rendering: pixelated;"></canvas>
    </div>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
      <p class="hud-label">seed <span id="reclaim-seed" class="text-blood">#—</span></p>
      <p class="hud-label opacity-60">click canvas to stamp · R new seed · H hide ui</p>
    </div>

    <div id="reclaim-panels">
      <!-- block palette -->
      <h2 class="hud-label text-blood mt-10">blocks</h2>
      <div id="reclaim-tools" class="mt-3 flex flex-wrap gap-2">
        <button data-tool="slab" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">slab</button>
        <button data-tool="tower" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">tower</button>
        <button data-tool="stairs" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">stairs</button>
        <button data-tool="arch" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">arch</button>
        <button data-tool="grove" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">grove</button>
        <button data-tool="planter" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">planter</button>
        <button data-tool="eraser" class="hud-label border border-bone/25 px-4 py-2 hover:border-blood hover:text-blood transition-colors">eraser</button>
      </div>

      <!-- climate -->
      <h2 class="hud-label text-blood mt-10">climate</h2>
      <div class="mt-3 grid grid-cols-1 md:grid-cols-3 border-t border-l border-bone/15">
        <div class="border-b border-r border-bone/15 px-4 py-4">
          <label class="hud-label flex justify-between" for="reclaim-growth">growth <span id="reclaim-growth-v">60%</span></label>
          <input id="reclaim-growth" type="range" min="0" max="100" value="60" class="mt-3 w-full accent-[#c8102e]" />
        </div>
        <div class="border-b border-r border-bone/15 px-4 py-4">
          <label class="hud-label flex justify-between" for="reclaim-density">density <span id="reclaim-density-v">55%</span></label>
          <input id="reclaim-density" type="range" min="0" max="100" value="55" class="mt-3 w-full accent-[#c8102e]" />
        </div>
        <div class="border-b border-r border-bone/15 px-4 py-4">
          <label class="hud-label flex justify-between" for="reclaim-mist">mist <span id="reclaim-mist-v">50%</span></label>
          <input id="reclaim-mist" type="range" min="0" max="100" value="50" class="mt-3 w-full accent-[#c8102e]" />
        </div>
      </div>

      <!-- actions -->
      <div class="mt-6 flex flex-wrap gap-3">
        <button id="reclaim-dice" class="bg-blood px-6 py-3 text-sm font-bold tracking-wide text-white rounded-[2px] hover:bg-[#a50d27] active:translate-y-px transition">↻ new seed</button>
        <button id="reclaim-copy" class="border border-bone/25 px-6 py-3 text-sm font-bold tracking-wide text-bone rounded-[2px] hover:border-blood hover:text-blood active:translate-y-px transition">copy seed</button>
        <button id="reclaim-clear" class="border border-bone/25 px-6 py-3 text-sm font-bold tracking-wide text-bone rounded-[2px] hover:border-blood hover:text-blood active:translate-y-px transition">clear blocks</button>
        <button id="reclaim-pal" class="border border-blood/60 px-6 py-3 text-sm font-bold tracking-wide text-blood rounded-[2px] hover:bg-blood hover:text-white active:translate-y-px transition">palette: control</button>
        <a id="reclaim-dl" download class="hud-label border border-bone/25 px-6 py-3.5 hover:border-blood hover:text-blood transition-colors cursor-pointer">↓ png</a>
      </div>
    </div>
  </section>

  <script>
    import { Reclaim, CELL, GW, GH, GROUND } from '../scripts/reclaim';
    import type { Anchor, BlockType } from '../scripts/reclaim';

    const view = document.getElementById('reclaim-view') as HTMLCanvasElement;
    const seedEl = document.getElementById('reclaim-seed')!;
    const toolsEl = document.getElementById('reclaim-tools')!;
    const panels = document.getElementById('reclaim-panels')!;
    const palBtn = document.getElementById('reclaim-pal') as HTMLButtonElement;

    const qs = new URLSearchParams(location.search);
    let seed = Number(qs.get('seed')) || Math.floor(Math.random() * 90000) + 1000;
    let tool: BlockType | 'eraser' = 'slab';
    let palette: 'control' | 'blood' = 'control';
    let anchors: Anchor[] = [
      { bx: 6, by: Math.floor(GROUND / CELL) - 12, t: 'tower' },
      { bx: 22, by: Math.floor(GROUND / CELL) - 4, t: 'slab' },
      { bx: 15, by: Math.floor(GROUND / CELL) - 4, t: 'grove' },
    ];

    const rc = new Reclaim(view, { seed, growth: 0.6, density: 0.55, mist: 0.5, palette });
    rc.setAnchors(anchors);

    function syncSeed() {
      seedEl.textContent = '#' + seed;
      history.replaceState(null, '', '?seed=' + seed);
    }
    syncSeed();

    function paintTools() {
      toolsEl.querySelectorAll('button').forEach((b) => {
        const on = (b as HTMLElement).dataset.tool === tool;
        b.classList.toggle('border-blood', on);
        b.classList.toggle('text-blood', on);
        b.classList.toggle('border-bone/25', !on);
      });
    }
    paintTools();

    toolsEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      tool = (b as HTMLElement).dataset.tool as BlockType | 'eraser';
      paintTools();
    });

    view.addEventListener('pointerdown', (e) => {
      const r = view.getBoundingClientRect();
      const bx = Math.floor(((e.clientX - r.left) / r.width) * GW);
      const by = Math.floor(((e.clientY - r.top) / r.height) * GH);
      if (tool === 'eraser') {
        anchors = anchors.filter((a) => Math.abs(a.bx - bx) > 3 || Math.abs(a.by - by) > 3);
      } else {
        anchors = anchors.filter((a) => !(a.bx === bx && a.by === by));
        anchors.push({ bx: Math.max(0, Math.min(GW - 4, bx)), by: Math.max(0, Math.min(GH - 2, by)), t: tool });
      }
      rc.setAnchors(anchors);
    });

    function bindRange(id: string, key: 'growth' | 'density' | 'mist') {
      const el = document.getElementById(id) as HTMLInputElement;
      const v = document.getElementById(id + '-v')!;
      el.addEventListener('input', () => {
        v.textContent = el.value + '%';
        rc.setParams({ [key]: Number(el.value) / 100 } as object);
      });
    }
    bindRange('reclaim-growth', 'growth');
    bindRange('reclaim-density', 'density');
    bindRange('reclaim-mist', 'mist');

    document.getElementById('reclaim-dice')?.addEventListener('click', () => {
      seed = Math.floor(Math.random() * 90000) + 1000;
      rc.setParams({ seed });
      syncSeed();
    });

    document.getElementById('reclaim-copy')?.addEventListener('click', async (e) => {
      try { await navigator.clipboard.writeText(location.origin + location.pathname + '?seed=' + seed); }
      catch { /* clipboard denied */ }
      const b = e.target as HTMLElement;
      const old = b.textContent;
      b.textContent = 'copied ✓';
      setTimeout(() => { b.textContent = old; }, 1200);
    });

    document.getElementById('reclaim-clear')?.addEventListener('click', () => {
      anchors = [];
      rc.setAnchors(anchors);
    });

    palBtn.addEventListener('click', () => {
      palette = palette === 'control' ? 'blood' : 'control';
      palBtn.textContent = 'palette: ' + palette;
      rc.setParams({ palette });
    });

    document.getElementById('reclaim-dl')?.addEventListener('click', (e) => {
      (e.currentTarget as HTMLAnchorElement).href = rc.snapshot(4);
    });

    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).tagName === 'INPUT' && (e.target as HTMLInputElement).type === 'text') return;
      if (e.key === 'r' || e.key === 'R') {
        seed = Math.floor(Math.random() * 90000) + 1000;
        rc.setParams({ seed });
        syncSeed();
      }
      if (e.key === 'h' || e.key === 'H') panels.classList.toggle('hidden');
    });

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      rc.frame(0);
    } else {
      const t0 = performance.now();
      (function loop() {
        if (document.hidden) { requestAnimationFrame(loop); return; }
        rc.frame(performance.now() - t0);
        requestAnimationFrame(loop);
      })();
    }
  </script>
</Base>
